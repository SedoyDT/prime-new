diff --git a/library/App/Depot/PhotoGallery/Index/Filter.php b/library/App/Depot/PhotoGallery/Index/Filter.php
index 27ac5f576b..3ba879f594 100644
--- a/library/App/Depot/PhotoGallery/Index/Filter.php
+++ b/library/App/Depot/PhotoGallery/Index/Filter.php
@@ -45,11 +45,200 @@ class Filter extends \App\Development\TypeScript\AbstractFilter
         $c = $this->isUseMaskSql() ? '' : 'SQL_CALC_FOUND_ROWS';
 
         $sql = "
-            SELECT
-                apc.*
-            FROM analytics_project_capitalization AS apc
-            {WHERE} 
-            ";
+                      SELECT SQL_CALC_FOUND_ROWS
+        d2.*,
+            CONCAT('/uploads/claim/detailed/', ddp.claim_id,'/', ddp.item_id,'/t_', ddp.filename) AS filename,
+            CONCAT('/uploads/claim/detailed/', ddp.claim_id,'/', ddp.item_id,'/',   ddp.filename) AS big_filename
+        FROM depot_detailed_photo AS ddp
+             INNER JOIN
+         (
+             SELECT
+                 d.id,
+                 field1.text AS title,
+                 d.field1 AS titleId,
+                 field2.text AS prop,
+                 d.field2 AS propId,
+                 field3.text AS color,
+                 d.field3 AS colorId,
+                 field4.text AS boxType,
+                 d.field4 AS boxTypeId,
+                 d.field5 AS volum,
+                 d.field6 AS height,
+                 d.field7 AS width,
+                 d.field8 AS depth,
+                 d.field9 AS labelWeight,
+                 d.field10 AS inBoxes,
+                 d.field11 AS totalAmount,
+                 d.field12 AS totalBoxes,
+                 field13.text AS description,
+                 d.field13 AS description_md5,
+                 d.field14 AS block,
+                 d.field15 AS type,
+                 d.field16 AS is_archive,
+        
+                 ROUND(
+                         IFNULL(
+                                 CASE WHEN d.field15 = 1
+                                          THEN d.field11 - d.field14
+                                      ELSE (d.field12 - d.field14) * (d.field11/d.field12)
+                                     END - IFNULL(ddm.amountWeight, 0),
+                                 0
+                         )
+                     , 5) AS amountWeight
+                     ,
+                 ROUND(
+                         IFNULL(
+                                 CASE WHEN d.field15 = 1
+                                          THEN (d.field11 - d.field14)/d.field10
+                                      ELSE d.field12 - d.field14
+                                     END - IFNULL(ddm.boxesRols, 0),
+                                 0
+                         )
+                     , 5) AS boxesRols,
+                 ddmc.managersBlocksRowsCount,
+                 IFNULL(IFNULL(bp2.cur_price, bp1.cur_price), '') AS basePriceValue,
+                 IFNULL(IFNULL(bp2.cur_price, bp1.cur_price), 0) + IFNULL(dae.value, 0) AS basePriceWithAdditionalExpenses,
+                 IF(d2iw.value = -1, 'н.д.', IFNULL(ROUND(IFNULL(bp2.cur_price, bp1.cur_price) * d2iw.value, 8), '')) AS basePricePerItemValue,
+                 IFNULL(bp2.cur_price, '') AS basePriceSaleValue,
+                 UNIX_TIMESTAMP(bp2.date_to) * 1000 AS basePriceSaleDateToUnix,
+                 IF(d2iw.value = -1, 'н.д.', ROUND(IFNULL(bp2.cur_price, bp1.cur_price) * d2iw.value, 8)) AS itemBasePrice,
+                 IFNULL(IFNULL(bp2_in.cur_price, bp1_in.cur_price), '') AS basePriceInValue,
+                 IF(d2iw.value = -1, 'н.д.', IFNULL(ROUND(IFNULL(bp2_in.cur_price, bp1_in.cur_price) * d2iw.value, 8), '')) AS basePriceInPerItemValue,
+                 IFNULL(bp2_in.cur_price, '') AS basePriceInSaleValue,
+                 IF(d2iw.value = -1, 'н.д.', ROUND(IFNULL(bp2_in.cur_price, bp1_in.cur_price) * d2iw.value, 8)) AS itemBasePriceIn,
+                 d2d.annotation_in AS annotationIn,
+                 d2d.product_type,
+                 d2iw.value AS item_weight
+             FROM depot_2 AS d
+                      INNER JOIN depot_2_data AS d2d
+                                 ON
+                                     d2d.item_id = d.id
+                      LEFT JOIN depot_2_item_weight AS d2iw
+                                ON
+                                    d2iw.id = d.id
+        
+                      LEFT JOIN depot_2_fields AS field1 ON
+                 field1.id = d.field1
+        
+        
+                      LEFT JOIN depot_2_fields AS field2 ON
+                 field2.id = d.field2
+        
+        
+                      LEFT JOIN depot_2_fields AS field3 ON
+                 field3.id = d.field3
+        
+        
+                      LEFT JOIN depot_2_fields AS field4 ON
+                 field4.id = d.field4
+        
+        
+                      LEFT JOIN depot_2_fields AS field13 ON
+                 field13.id = d.field13
+        
+        
+                      LEFT JOIN (    SELECT
+                                         sub_dd.item_id,
+                                         IFNULL(SUM(
+                                                        sub_vddm.amount                         
+                                                            - IFNULL(IF (                           
+                                                                             sub_d2.field15 = 1,
+                                                                             sub_vddmbi.block,
+                                                                             ((sub_vddm.amount/sub_vddm.boxes) * sub_vddmbi.block)
+                                                                     ), 0)
+                                                ), 0) as amountWeight,
+                                         IFNULL(SUM(
+                                                        sub_vddm.boxes                          
+                                                            - IFNULL(IF (                           
+                                                                             sub_d2.field15 = 2,
+                                                                             sub_vddmbi.block,
+                                                                             sub_vddmbi.block / (sub_vddm.amount/sub_vddm.boxes)
+                                                                     ), 0)
+                                                ), 0) AS boxesRols
+                                     FROM depot_detailed AS sub_dd
+                                              JOIN depot_2 AS sub_d2 ON
+                                         sub_d2.id = sub_dd.item_id
+                                              LEFT JOIN claims AS sub_cl ON
+                                         sub_cl.id = sub_dd.claim_id
+                                              INNER JOIN view_depot_detailed_manager AS sub_vddm ON
+                                         sub_vddm.dd_id = sub_dd.id
+                                              LEFT JOIN view_depot_detailed_manager_block_info AS sub_vddmbi ON
+                                         sub_vddmbi.dd_id = sub_vddm.dd_id AND
+                                         sub_vddmbi.user_id = sub_vddm.user_id
+                                              LEFT JOIN orgstructure_users AS sub_ou ON
+                                         sub_ou.userId = sub_vddm.user_id
+                                     WHERE
+                                         `sub_vddm`.`user_id` IS NOT NULL AND `sub_vddm`.`amount` > 0 AND `sub_cl`.`claim_status` = 0 AND sub_dd.depot_id IN (2) AND FALSE
+                                     GROUP BY sub_dd.item_id) AS ddm ON
+                 ddm.item_id = d.id
+        
+        
+                      LEFT JOIN (    SELECT
+                                         sub_dd.item_id,
+                                         COUNT(DISTINCT sub_dd.id) AS managersBlocksRowsCount
+                                     FROM depot_detailed AS sub_dd
+                                              LEFT JOIN claims AS sub_cl ON
+                                         sub_cl.id = sub_dd.claim_id
+                                              INNER JOIN view_depot_detailed_manager AS sub_vddm
+                                                         ON sub_vddm.dd_id = sub_dd.id
+                                              LEFT JOIN orgstructure_users AS sub_ou ON
+                                         sub_ou.userId = sub_vddm.user_id
+                                     WHERE
+                                         `sub_vddm`.`user_id` IS NOT NULL AND `sub_vddm`.`amount` > 0 AND `sub_cl`.`claim_status` = 0 AND sub_dd.depot_id IN (2)
+                                     GROUP BY sub_dd.item_id) AS ddmc ON
+                 ddmc.item_id = d.id
+        
+        
+                      LEFT JOIN base_prices AS bp1
+                                ON
+                                    (bp1.item_id = d.id) AND
+                                    (bp1.type = 1) AND
+                                    (bp1.bp_type = 1) AND
+                                    (bp1.cur_date <= NOW()) AND
+                                    (bp1.date_to >= NOW() OR bp1.date_to IS NULL) AND
+                                    (bp1.depot_id = 2)
+                      LEFT JOIN depot_additional_expenses AS dae ON
+                 dae.depot_id = 2 AND
+                 dae.product_id = d.id
+                      LEFT JOIN base_prices AS bp2
+                                ON
+                                    (bp2.item_id = d.id) AND
+                                    (bp2.type = 2) AND
+                                    (bp2.bp_type = 1) AND
+                                    (bp2.cur_date <= NOW()) AND
+                                    (bp2.date_to >= NOW() OR bp2.date_to IS NULL) AND
+                                    (bp2.depot_id = 2)
+        
+                      LEFT JOIN base_prices AS bp1_in
+                                ON
+                                    (bp1_in.item_id = d.id) AND
+                                    (bp1_in.type = 1) AND
+                                    (bp1_in.bp_type = 2) AND
+                                    (bp1_in.cur_date <= NOW()) AND
+                                    (bp1_in.date_to >= NOW() OR bp1_in.date_to IS NULL) AND
+                                    (bp1_in.depot_id = 2)
+                      LEFT JOIN base_prices AS bp2_in
+                                ON
+                                    (bp2_in.item_id = d.id) AND
+                                    (bp2_in.type = 2) AND
+                                    (bp2_in.bp_type = 2) AND
+                                    (bp2_in.cur_date <= NOW()) AND
+                                    (bp2_in.date_to >= NOW() OR bp2_in.date_to IS NULL) AND
+                                    (bp2_in.depot_id = 2)
+        
+         ) AS d2
+         ON
+             d2.id = ddp.item_id
+        WHERE  (d2.amountWeight > 0)
+        ORDER BY id asc LIMIT 0, 24
+        ";
+
