                setUpFileUploadForm('tb-file-form-tk');
                this.fileFormRestoreCheckboxes();
            }

            csf.getStateSelector().change(function(){
                if (!csf.enabledChangeStatusSample) {
                    this.value="empty";
                    $('#changeStatusForm')[0].onsubmit = function(){return false;};
                    return;
                }
                window.location.hash = 'changeStatusForm';

                var submitButtons = $('table.submit-buttons');

                if (csf.hasSelectedAnyState()) {
                    submitButtons.hide();
                }else{
                    submitButtons.show();
                }
            });

            csf.getCancelButton().click(function() {
                window.location.hash = '#';
            });

            csf.customResetForm();
        });
    </script>

    <form id="changeStatusForm" method="post"
          action="<?php echo $this->linkPrefix(); ?>/cash/planned/<?php echo htmlspecialchars($this->cashType); ?>/change-state-perform">
        <input type="hidden" name="transactionId" value="<?php echo htmlspecialchars($tr->id) ?>"/>

        <div class="csf-content">
            <table width="550" cellpadding="0" cellspacing="1" border="0"
                   class="amd-table font-size_rem_08 square-text-input prepareTransaction csf-form-content" style="display: block;">
