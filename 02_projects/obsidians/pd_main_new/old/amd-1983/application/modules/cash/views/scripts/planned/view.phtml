    var CashPlannedObject = {
        transaction: <?php echo json_encode($tr, JSON_NUMERIC_CHECK) ?>,
        permissions: permissions,
        documentControl: transactions,
        supplyDepartmentBlockEnabled: <?php echo (int) $this->showSupplyDepartmentSupport?>,
        isOriginalDocumentExists: function () {
            if (!this.documentControl[this.transaction.id].documents) {
                return false;
            }
            return this.documentControl[this.transaction.id].documents.some(function (document) {
                return document.type2 == 1 || document.type2 == 3;
            });
        },
        _modules: {}, // дополнительные модули проверок и тп, модуль должен содержать метод save
        save: function(sendData)
        {
            var errors = [];
            var result;
            for (var i in this._modules) {
                if (true !== (result = this._modules[i].info(sendData))) {
                    errors.push(result);
                }
            }

            if (errors.length) {
                alert(errors.join('\n'));
                return false;
            }

            return true;
        }
    };

