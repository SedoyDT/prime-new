/**
 * Получение названия кнопки
 * @param $stateName
 * @param bool $tk
 * @return string
 * @throws Exception
 */
function _getButtonTitle($stateName, $tk = false)
{
    switch ($stateName) {
        default:
            throw new \Exception('Unknown stateName ' . var_export($stateName, true));

        case 'save-changes':
            return 'Сохранить';

        case 'postpone':
            if ($tk) {
                return 'отложить(ТК)';
            }
            return 'отложить';

        case 'reject':
            return 'отклонить';

        case 'accept':
            return 'провести';
    }
}


/**
 * Получение стиля кнопки
 * @param $stateName
 * @return string
 */
function _getButtonCssClass($stateName)
{
    switch ($stateName) {
        default:
            return strtolower($stateName);

        case 'save-changes':
            return 'accept';

        case 'postpone':
            return 'disaccept';
    }
}
