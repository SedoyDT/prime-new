# --- Obsidian: сначала игнорим всё ---
.obsidian/*

# --- потом РАЗРЕШАЕМ нужное ---
!.obsidian/app.json
!.obsidian/appearance.json
!.obsidian/core-plugins.json
!.obsidian/hotkeys.json

# (если используешь темы)
!.obsidian/themes/

# (если хочешь хранить список плагинов, но не их данные)
!.obsidian/plugins/
.obsidian/plugins/*/data.json

# --- всегда игнорим ---
.obsidian/workspace*
.obsidian/graph.json
.obsidian/cache/

# --- прочее ---
.idea/
.DS_Store
Thumbs.db