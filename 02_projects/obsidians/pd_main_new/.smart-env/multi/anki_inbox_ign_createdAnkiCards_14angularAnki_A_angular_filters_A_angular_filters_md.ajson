"smart_blocks:anki_inbox/ign/createdAnkiCards/14angularAnki/A_angular_filters/A_angular_filters.md#Примечание: Названия фильтров должны быть действительными идентификаторами выражений AngularJS, такими как **uppercase** или **orderBy**. Нельзя использовать специальные символы, такие как дефисы или точки. Если вы хотите сделать пространство имен для фильтров, вы можете использовать заглавные буквы (например, **myappSubsectionFilterx**) или подчеркивания (например, **myapp_subsection_filterx**).": {"path":null,"last_embed":{"hash":"1ji4fyh","at":1776450742857},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06487937,-0.08139157,0.00955789,-0.07573879,-0.00816515,0.00831183,0.02863744,0.01685148,0.00334567,-0.00987446,-0.04294489,-0.02720131,0.05122356,0.05750582,0.04463996,0.05517546,-0.00952891,0.0183505,-0.06783503,-0.03650507,0.06090401,-0.02149298,-0.01983131,-0.06010206,0.01564923,0.05683602,0.00079649,-0.02999218,0.00544259,-0.17466658,-0.02896106,-0.01099819,0.05762351,-0.02309519,0.00262485,-0.06804043,-0.04852617,0.03797368,-0.04686474,0.01940412,0.02791304,-0.00217367,-0.02018493,-0.04956624,-0.04687767,-0.02616832,0.0198943,-0.031739,-0.03676907,-0.0134208,-0.05757253,-0.04763033,-0.00500031,0.01082466,0.01487107,0.00129126,0.00034665,0.05104192,0.04315735,0.01735292,0.03155113,-0.05305847,-0.18030907,0.07028539,-0.05531573,0.02665375,-0.03038329,-0.02363276,0.01681079,-0.00825564,0.00387034,0.02307859,0.01547257,0.0861635,-0.05191653,-0.04285454,-0.00914958,0.01233565,0.00182665,0.01191248,-0.05078441,0.0057694,-0.05268776,0.00822953,0.0048459,0.01875216,0.0458401,-0.0838397,0.03170208,0.03164051,-0.00352591,-0.0501607,0.04993025,0.08003788,-0.02218991,0.00328223,-0.01000961,0.02651948,-0.02453769,0.10583755,0.00744334,0.02130537,-0.0162136,-0.04863,0.00739317,-0.04365962,-0.03255648,-0.05446288,-0.04197742,0.05345422,-0.06068322,-0.04733275,0.0373936,-0.03572682,0.00967108,0.0197226,0.09731077,0.01287186,-0.01531872,-0.01122273,-0.02096771,-0.00894885,0.