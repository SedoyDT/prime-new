"smart_blocks:anki_inbox/ign/createdAnkiCards/12tsanki/T/T_typescript_narrowing/T_typescript_narrowing.md#Оператор **`!`** автоматически сужает тип в TypeScript. Когда мы проверяем условие `!values`, TypeScript понимает, что внутри этого блока `if`, тип `values` может быть только `undefined`. А в ветке **`else`** тип `values` автоматически сужается до массива чисел (`number[]`), так как мы исключили вариант, что это `undefined`.": {"path":null,"last_embed":{"hash":"4g8eat","at":1776450821618},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.06961718,-0.00363901,0.02392848,0.0159263,-0.04401254,0.06438939,0.00171257,0.07679209,0.0229315,-0.01878924,-0.04861334,-0.06609318,0.01989591,0.04474963,0.01746696,0.02660251,-0.05503971,0.04487766,-0.13193126,-0.03955653,0.1527506,-0.02603197,-0.01856983,-0.04347787,-0.01401596,0.06213505,0.00836068,-0.04931928,0.01092091,-0.14965761,-0.06415887,-0.0117525,0.01395871,-0.04710268,0.02360644,-0.02746126,-0.06357273,0.01576648,-0.04521906,0.09887989,0.01169529,0.02837113,0.02842125,-0.0606573,-0.01367523,-0.05810616,-0.03834789,0.00791659,-0.063594,0.0028714,-0.12949067,-0.01552831,-0.00716015,0.0037125,0.02853087,0.01537042,0.05926061,0.06552163,0.03868682,0.05298477,0.06840949,-0.00337045,-0.18716738,0.01245229,0.02216262,0.01977669,-0.03592147,-0.04562747,0.01344861,-0.0290052,0.0338772,-0.0114069,0.05500443,0.08189481,-0.04119452,-0.03210263,-0.00940425,-0.02731994,0.02067729,0.02680376,-0.00413563,-0.03499506,-0.06521568,-0.03687105,0.01940229,-0.04071335,0.00670975,-0.01299598,0.03820033,0.01718325,0.01305829,-0.01544027,0.00703397,0.03244945,-0.02794511,-0.00249056,-0.03737084,-0.00924855,-0.04986291,0.09333921,-0.01063084,0.00789948,-0.02181358,-0.00522134,0.01146444,0.00290961,-0.03635142,-0.05492288,0.00071772,0.01436638,-0.10240725,-0.05373415,0.04114604,-0.03500829,-0.02887517,0.02696656,0.03017192,-0.01723813,-0.01454016,0.0386742,0.01442657,-0.00895317,0.02318278,0.02405051,0.04393113,0.00844869,0.00666934,0.0752365