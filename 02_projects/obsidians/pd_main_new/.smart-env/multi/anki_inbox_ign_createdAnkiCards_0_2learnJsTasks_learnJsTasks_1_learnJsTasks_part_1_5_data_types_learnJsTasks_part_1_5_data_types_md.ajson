ращает «европейский» день недели для даты date.":[71,93],"#В Европейских странах неделя начинается с понедельника (день номер 1), затем идёт вторник (номер 2) и так до воскресенья (номер 7). Напишите функцию getLocalDay(date), которая возвращает «европейский» день недели для даты date.#{1}":[72,93],"#learnJsTasks_part_1_5_data_types[6]":[94,94],"#part_1_5_data_types[6]":[95,96],"#telegram[6]":[97,98],"#Напишите функцию getWeekDay(date), показывающую день недели в коротком формате: «ПН», «ВТ», «СР», «ЧТ», «ПТ», «СБ», «ВС».":[99,116],"#Напишите функцию getWeekDay(date), показывающую день недели в коротком формате: «ПН», «ВТ», «СР», «ЧТ», «ПТ», «СБ», «ВС».#{1}":[100,116],"#learnJsTasks_part_1_5_data_types[7]":[117,117],"#part_1_5_data_types[7]":[118,119],"#telegram[7]":[120,121],"#Создайте объект Date для даты: 20 февраля 2012 года, 3 часа 12 минут. Временная зона – местная.":[122,133],"#Создайте объект Date для даты: 20 февраля 2012 года, 3 часа 12 минут. Временная зона – местная.#{1}":[123,133],"#learnJsTasks_part_1_5_data_types[8]":[134,134],"#part_1_5_data_types[8]":[135,136],"#telegram[8]":[137,138],"#Что в общем можно сказать про Date в js?":[139,169],"#Что в общем можно сказать про Date в js?#{1}":[140,169],"#learnJsTasks_part_1_5_data_types[9]":[170,170],"#part_1_5_data_types[9]":[171,172],"#telegram[9]":[173,174],"#Что делает метод Date.parse(str)?":[175,193],"#Что делает метод Date.parse(str)?#{1}":[176,193],"#learnJsTasks_part_1_5_data_types[10]":[194,194],"#part_1_5_data_types[10]":[195,196],"#telegram[10]":[197,198],"#У нас есть объект salaries с зарплатами:":[199,239],"#У нас есть объект salaries с зарплатами:#{1}":[200,210],"#У нас есть объект salaries с зарплатами:#{2}":[211,211],"#У нас есть объект salaries с зарплатами:#{3}":[212,213],"#У нас есть объект salaries с зарплатами:#{4}":[214,239],"#learnJsTasks_part_1_5_data_types[11]":[240,240],"#part_1_5_data_types[11]":[241,242],"#telegram[11]":[243,244],"#У нас есть объект:":[245,2697],"#У нас есть объ