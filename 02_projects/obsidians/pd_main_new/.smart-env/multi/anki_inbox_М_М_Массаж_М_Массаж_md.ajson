:[274,274],"#Массаж[5]":[275,276],"#telegram[5]":[277,278],"#Да, ты прав — **мы договаривались про допустимый максимум**.":[279,364],"#Да, ты прав — **мы договаривались про допустимый максимум**.#{1}":[280,364],"#М_Массаж[6]":[365,365],"#Массаж[6]":[366,367],"#telegram[6]":[368,369],"#Rf":[370,379],"#Rf#{1}":[371,379]},"outlinks":[],"metadata":{"tags":["#М_Массаж","#Массаж","#telegram"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"anki_inbox/М/М_Массаж/М_Массаж.md"},
