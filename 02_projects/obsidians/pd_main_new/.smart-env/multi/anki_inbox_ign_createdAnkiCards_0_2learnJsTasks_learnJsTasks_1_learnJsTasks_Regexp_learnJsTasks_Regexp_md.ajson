рицательный набор символов.":[104,114],"#Запишите выражение, которое будет соответствовать чему-либо, кроме слов beor и beur в тексте. Сделайте это, используя отрицательный набор символов.#{1}":[105,114],"#learnJsTasks_Regexp[5]":[115,115],"#Regexp[5]":[116,117],"#telegram[5]":[118,119],"#Напишите фразу, которая соответствует каждому слову в тексте. Единственные символы, которые меняются - это инициалы слов.":[120,131],"#Напишите фразу, которая соответствует каждому слову в тексте. Единственные символы, которые меняются - это инициалы слов.#{1}":[121,131],"#learnJsTasks_Regexp[6]":[132,132],"#Regexp[6]":[133,134],"#telegram[6]":[135,136],"#Введите выражение для выбора отдельных букв, цифр, пробелов и специальных символов в тексте. Вводимое выражение должно соответствовать любому символу":[137,147],"#Введите выражение для выбора отдельных букв, цифр, пробелов и специальных символов в тексте. Вводимое выражение должно соответствовать любому символу#{1}":[138,147],"#learnJsTasks_Regexp[7]":[148,148],"#Regexp[7]":[149,150],"#telegram[7]":[151,152],"#Чтобы найти числа в указанном диапазоне, начальный номер и конечный номер записываются в квадратных скобках [] с тире - между ними. Напишите выражение, которое выберет все числа от 3 до 6, включая самих себя.":[153,163],"#Чтобы найти числа в указанном диапазоне, начальный номер и конечный номер записываются в квадратных скобках [] с тире - между ними. Напишите выражение, которое выберет все числа от 3 до 6, включая самих себя.#{1}":[154,163],"#learnJsTasks_Regexp[8]":[164,164],"#Regexp[8]":[165,166],"#telegram[8]":[167,168],"#**Буквенный диапазон**":[169,182],"#**Буквенный диапазон**#{1}":[170,182],"#learnJsTasks_Regexp[9]":[183,183],"#Regexp[9]":[184,185],"#telegram[9]":[186,187],"#**Наборы негативных символов":[188,202],"#**Наборы негативных символов#{1}":[189,202],"#learnJsTasks_Regexp[10]":[203,203],"#Regexp[10]":[204,205],"#telegram[10]":[206,207],"#**Наборы негативных символов[2]":[208,222],"#**Наборы негативных символов[2]#{1}":[209,222],"#learnJsTasks_Regexp[11]":[223,223],"#Regexp[11]":[224,225],"#telegram[11]":[226,227],"#Если одним из символов в слове могут быть разные символы, мы записываем его в":[228,242],"#Если одним из символов в слове могут быть разные символы, мы записываем его в#{1}":[229,242],"#learnJsTasks_Regexp[12]":[243,243],"#Regexp[12]":[244,245],"#telegram[12]":[246,247],"#Если одним из символов в слове могут быть разные символы, мы записываем его в[2]":[248,258],"#Если одним из символов в слове могут быть разные символы, мы записываем его в[2]#{1}":[249,258]},"outlinks":[],"metadata":{"tags":["#learnJsTasks_Regexp","#Regexp","#telegram"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"anki_inbox/ign/createdAnkiCards/0.2learnJsTasks/learnJsTasks 1/learnJsTasks_Regexp/learnJsTasks_Regexp.md"},
