#telegram[6]":[190,191],"#ВДХ | 1153":[192,218],"#ВДХ | 1153#{1}":[193,218],"#К_Книга_ИсскуствоИгрыСмиром[7]":[219,219],"#Книга_ИсскуствоИгрыСмиром[7]":[220,221],"#telegram[7]":[222,223],"#ВДХ | 1153[2]":[224,250],"#ВДХ | 1153[2]#{1}":[225,250],"#К_Книга_ИсскуствоИгрыСмиром[8]":[251,251],"#Книга_ИсскуствоИгрыСмиром[8]":[252,253],"#telegram[8]":[254,255],"#3.6":[256,284],"#3.6#{1}":[257,284],"#К_Книга_ИсскуствоИгрыСмиром[9]":[285,285],"#Книга_ИсскуствоИгрыСмиром[9]":[286,287],"#telegram[9]":[288,289],"#В состояниях нужно всегда уметь вычленять отдельные составляющие, то есть состояние тела, состояние чувств, состояние образов, состояние ума, состояние духа и состояние обстоятельств.":[290,319],"#В состояниях нужно всегда уметь вычленять отдельные составляющие, то есть состояние тела, состояние чувств, состояние образов, состояние ума, состояние духа и состояние обстоятельств.#{1}":[291,319],"#К_Книга_ИсскуствоИгрыСмиром[10]":[320,320],"#Книга_ИсскуствоИгрыСмиром[10]":[321,322],"#telegram[10]":[323,324],"#3.2":[325,357],"#3.2#{1}":[326,357],"#К_Книга_ИсскуствоИгрыСмиром[11]":[358,358],"#Книга_ИсскуствоИгрыСмиром[11]":[359,360],"#telegram[11]":[361,362],"#3.1":[363,382],"#3.1#{1}":[364,382],"#К_Книга_ИсскуствоИгрыСмиром[12]":[383,383],"#Книга_ИсскуствоИгрыСмиром[12]":[384,385],"#telegram[12]":[386,387],"#Если ты тратишь слишком много силы на какую-то позицию в ущерб другим, забывая о других, тогда твоя система разлаживается и теряет равновесие. Потому, когда тебя вдруг вовлекает в какой-то поток, помни обо всех остальных.":[388,406],"#Если ты тратишь слишком много силы на какую-то позицию в ущерб другим, забывая о других, тогда твоя система разлаживается и теряет равновесие. Потому, когда тебя вдруг вовлекает в какой-то поток, помни обо всех остальных.#{1}":[389,406],"#К_Книга_ИсскуствоИгрыСмиром[13]":[407,407],"#Книга_ИсскуствоИгрыСмиром[13]":[408,409],"#telegram[13]":[410,411],"#Четвертая питает пятую, которая питает первую, будучи сдерживаемой четвертой.":[412,446],"#Четвертая питает пятую, которая питает первую, будучи сдерживаемой четвертой.#{1}":[413,446],"#К_Книга_ИсскуствоИгрыСмиром[14]":[447,447],"#Книга_ИсскуствоИгрыСмиром[14]":[448,449],"#telegram[14]":[450,451],"#Все надеешься поймать свой случай? Поздно уже. Остались только воздаяния.":[452,493],"#Все надеешься поймать свой случай? Поздно уже. Остались только воздаяния.#{1}":[453,493],"#К_Книга_ИсскуствоИгрыСмиром[15]":[494,494],"#Книга_ИсскуствоИгрыСмиром[15]":[495,496],"#telegram[15]":[497,498],"#2.4":[499,523],"#2.4#{1}":[500,523],"#К_Книга_ИсскуствоИгрыСмиром[16]":[524,524],"#Книга_ИсскуствоИгрыСмиром[16]":[525,526],"#telegram[16]":[527,528],"#2.2":[529,561],"#2.2#{1}":[530,561],"#К_Книга_ИсскуствоИгрыСмиром[17]":[562,562],"#Книга_ИсскуствоИгрыСмиром[17]":[563,564],"#telegram[17]":[565,566],"#2.1":[567,587],"#2.1#{1}":[568,587],"#К_Книга_ИсскуствоИгрыСмиром[18]":[588,588],"#Книга_ИсскуствоИгрыСмиром[18]":[589,590],"#telegram[18]":[591,592],"#Отсутствия осмысленных действий никогда не бывает в пространстве творческих состояний, в пространстве игры.":[593,623],"#Отсутствия осмысленных действий никогда не бывает в пространстве творческих состояний, в пространстве игры.#{1}":[594,623],"#К_Книга_ИсскуствоИгрыСмиром[19]":[624,624],"#Книга_ИсскуствоИгрыСмиром[19]":[625,626],"#telegram[19]":[627,628],"#1.5.5":[629,649],"#1.5.5#{1}":[630,649],"#К_Книга_ИсскуствоИгрыСмиром[20]":[650,650],"#Книга_ИсскуствоИгрыСмиром[20]":[651,652],"#telegram[20]":[653,654],"#Чего только нет в человеческом сердце.":[655,690],"#Чего только нет в человеческом сердце.#{1}":[656,690],"#К_Книга_ИсскуствоИгрыСмиром[21]":[691,691],"#Книга_ИсскуствоИгрыСмиром[21]":[692,693],"#telegram[21]":[694,695],"#1.4.9":[696,739],"#1.4.9#{1}":[697,739],"#К_Книга_ИсскуствоИгрыСмиром[22]":[740,740],"#Книга_ИсскуствоИгрыСмиром[22]":[741,742],"#telegram[22]":[743,744],"#бережлив в проявлении вовне своих переживаний. Тогда все будет хорошо.":[745,768],"#бережлив в проявлении вовне своих переживаний. Тогда все будет хорошо.#{1}":[746,768],"#К_Книга_ИсскуствоИгрыСмиром[23]":[769,769],"#Книга_ИсскуствоИгрыСмиром[23]":[770,771],"#telegram[23]":[772,773],"#Пока собираешься, время уходит.":[774,809],"#Пока собираешься, время уходит.#{1}":[775,809],"#К_Книга_ИсскуствоИгрыСмиром[24]":[810,810],"#Книга_ИсскуствоИгрыСмиром[24]":[811,812],"#telegram[24]":[813,814],"#Все пять движений игры – это пять видов движения духа. Нужно учиться делать играючи движение духа, то есть чувствовать качество исследования, обучения, общения, творчества и управления в каждом из движений.":[815,852],"#Все пять движений игры – это пять видов движения духа. Нужно учиться делать играючи движение духа, то есть чувствовать качество исследования, обучения, общения, творчества и управления в каждом из движений.#{1}":[816,852],"#К_Книга_ИсскуствоИгрыСмиром[25]":[853,853],"#Книга_ИсскуствоИгрыСмиром[25]":[854,855],"#telegram[25]":[856,857],"#1.4. Применение исследовательского движения духа":[858,894],"#1.4. Применение исследовательского движения духа#{1}":[859,894],"#К_Книга_ИсскуствоИгрыСмиром[26]":[895,895],"#Книга_ИсскуствоИгрыСмиром[26]":[896,897],"#telegram[26]":[898,899],"#ВДХ | 1719":[900,931],"#ВДХ | 1719#{1}":[901,931],"#К_Книга_ИсскуствоИгрыСмиром[27]":[932,932],"#Книга_ИсскуствоИгрыСмиром[27]":[933,934],"#telegram[27]":[935,936],"#1.3.7":[937,958],"#1.3.7#{1}":[938,958],"#К_Книга_ИсскуствоИгрыСмиром[28]":[959,959],"#Книга_ИсскуствоИгрыСмиром[28]":[960,961],"#telegram[28]":[962,963],"#Исследуя, обучайся. Обучая, исследуй. И обязательно играй, превращая одно в другое, стирая грань, подменяя суть. Только так.":[964,994],"#Исследуя, обучайся. Обучая, исследуй. И обязательно играй, превращая одно в другое, стирая грань, подменяя суть. Только так.#{1}":[965,994],"#К_Книга_ИсскуствоИгрыСмиром[29]":[995,995],"#Книга_ИсскуствоИгрыСмиром[29]":[996,997],"#telegram[29]":[998,999],"#это состояние свободы, переживание свободы вне зависимости от того, какие обстоятельства пытаются окружить и сковать твою свободу.":[1000,1046],"#это состояние свободы, переживание свободы вне зависимости от того, какие обстоятельства пытаются окружить и сковать твою свободу.#{1}":[1001,1046],"#К_Книга_ИсскуствоИгрыСмиром[30]":[1047,1047],"#Книга_ИсскуствоИгрыСмиром[30]":[1048,1049],"#telegram[30]":[1050,1051],"#Тело-душа-дух, то есть тело-чувство-сознание, представлены лестницей ощущений-чувств-образов-понятий-смыслов-действий.":[1052,1090],"#Тело-душа-дух, то есть тело-чувство-сознание, представлены лестницей ощущений-чувств-образов-понятий-смыслов-действий.#{1}":[1053,1090],"#К_Книга_ИсскуствоИгрыСмиром[31]":[1091,1091],"#Книга_ИсскуствоИгрыСмиром[31]":[1092,1093],"#telegram[31]":[1094,1095],"#видеть закономерности изменений в ощущениях, ибо в этом случае они перестают волноваться переживаемыми чувствами, и ты видишь лишь движущиеся потоки, которые переходят в теле изнутри вовне и извне вовнутрь, создавая сообщение между поверхностными и глубинными отделами пространства ощущений.":[1096,1113],"#видеть закономерности изменений в ощущениях, ибо в этом случае они перестают волноваться переживаемыми чувствами, и ты видишь лишь движущиеся потоки, которые переходят в теле изнутри вовне и извне вовнутрь, создавая сообщение между поверхностными и глубинными отделами пространства ощущений.#{1}":[1097,1113],"#К_Книга_ИсскуствоИгрыСмиром[32]":[1114,1114],"#Книга_ИсскуствоИгрыСмиром[32]":[1115,1116],"#telegram[32]":[1117,1118],"#Дух – это пространство дум, которое требует подключения воли, потому что иначе поток все время уносит тебя в переживаемые ощущения, а каждое переживаемое ощущение создает чувственные образы, с помощью которых дух создает описание происходящего.":[1119,1140],"#Дух – это пространство дум, которое требует подключения воли, потому что иначе поток все время уносит тебя в переживаемые ощущения, а каждое переживаемое ощущение создает чувственные образы, с помощью которых дух создает описание происходящего.#{1}":[1120,1140],"#К_Книга_ИсскуствоИгрыСмиром[33]":[1141,1141],"#Книга_ИсскуствоИгрыС