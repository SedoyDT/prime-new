+    /**
+     * @param $call
+     * @return array|null
+     * @throws \Zend_Db_Statement_Exception
+     */
+    public function applyCreationRuleEffects($call): ?array
+    {
+        $lead = null;
+        $creationRule = $this->creationRuleRepository->findByCallid($call->atsCallid);
+        
+        if (!$creationRule->isPersistent()) {
+            $creationRule = null;
+        }
+
+        // запуск создания по правилу создания
+        if (!is_null($creationRule)) {
+            // нужно создать лид
+            if ($creationRule->getCreateNew()) {
+                $lead = $this->leadFactory->fromAtsCallid($call->atsCallid);
+                if (
+                    // лида нет
+                    !$lead->getEntity()->isPersistent() ||
+                    // звонок прикрепился к существующему лиду с несколькими звонками,
+                    (new \App\SalesFunnel\Lead\Relation\Query())
+                        ->byRelationType(\App_Constant_Table_SalesFunnelLeadRelationType::TYPE_CALL)
+                        ->byLeadId([$lead->getEntity()->getId()])
+                        ->count() > 1
+                ) {
+                    $lead = $this->createLeadModelFromCall($call);
+                }
+
+                // при работе createLeadModelFromCall может получиться null
+                if (!is_null($lead)) {
+                    $lead->getEntity()->setTitle($creationRule->getLeadTitle());
+                }
+            }
+            // нужно прикрепить звонок к лиду
+            else if ($creationRule->getTargetLeadId())
+            {
+                $lead = $this->leadFactory->fromId($creationRule->getTargetLeadId());
+
+                if (!empty($call->getPhoneList())) {
+                    $lead->getPhoneCollection()->addIfNotExists(
+                        $this->leadPhoneFactory
+                            ->emptyModel()
+                            ->setPhone($call->getPhoneList()[0])
+                    );
+                }
+            }
+        }
+        
+        return [$lead, $creationRule];
+    }
+
+    /**
+     * @param $call
+     * @return Model|null
+     * @throws \Zend_Db_Select_Exception
+     * @throws \Zend_Db_Statement_Exception
+     */
+    public function defaultLeadCreation($call): ?Model
+    {
+        $lead = null;
+        if (!empty($call->getPhoneList())) {
+            $lead = $this->leadFactory->findLeadByCallParams(
+                $call->getPhoneList()[0],
+                $call->manager,
+                DateTimeImmutable::createFromFormat(MYSQL_DATETIME_FORMAT, $call->date)
+            );
+
+            if ($lead->getEntity()->isPersistent()) {
+                // пробуем добавить телефон из звонка
+                $lead->getPhoneCollection()->addIfNotExists(
+                    $this->leadPhoneFactory
+                        ->emptyModel()
+                        ->setPhone($call->getPhoneList()[0])
+                );
+            }
+            // подходящая для привязки модель не найдена
+            else {
+                $lead = $this->createLeadModelFromCall($call);
+            }
+        }
+
+
+        return $lead;
+    }
+
+
+    /**
+     * @param $lead
+     * @param $call
+     * @return Model|null
+     * @throws Exception
+     */
+    public function setIsAdvertising($lead, $call): ?Model
+    {
+        $lead->getEntity()->setIsAdvertising(true);
+        if (!$lead->getEntity()->getAdvertisingPlatformId()) {
+            $lead->getEntity()->setAdvertisingPlatformId($call->advertisingPlatformId);
+        }
+
+        $this->leadCrud->saveModel($lead);
+
+        return $lead;
+    }
+
+    /**
+     * @param $lead
+     * @return Model|null
+     * @throws \Zend_Db_Statement_Exception
+     */
+    public function setSubstitutes($lead): ?Model
+    {
+        $leadOwner = $lead->getEntity()->getUserId();
+        $substitutes = \App_Db_Vacations::obtain()->getUsersSubstitutes([$leadOwner]);
+        if(!empty($substitutes)) {
+            $previous = \App_Db_Users::obtain()->getUserName($lead->getEntity()->getUserId());
+            $reason = $this->eventGenerator->getEventReason();
+            $this->eventGenerator->setEventReason('отпуск изначального сотрудника: ' . $previous);
+            $lead->changeOwner($substitutes[$leadOwner][0]);
+            $this->leadCrud->saveModel($lead);
+            $this->eventGenerator->setEventReason($reason);
+        }
+
+        return $lead;
+    }
+
+    /**
+     * @param $lead
+     * @param $creationRule
+     * @return Model|null
+     * @throws \App_Network_Sender_Exception
+     * @throws \Zend_Form_Exception
+     */
+    public function setTasks($lead, $creationRule): ?Model
+    {
+        if ($creationRule->getCalendarNotification()) {
+            foreach ($creationRule->getCalendarNotification() as $item) {
+                $this->relationManager->addRelationOrUpdateLead(
+                    \App_Constant_Table_SalesFunnelLeadRelationType::TYPE_CALENDAR_NOTIFICATION,
+                    $lead->getEntity()->getId(),
+                    $item
+                );
+            }
+        }
+        if ($creationRule->getStaffTask()) {
+            foreach ($creationRule->getStaffTask() as $item) {
+                $this->relationManager->addRelationOrUpdateLead(
+                    \App_Constant_Table_SalesFunnelLeadRelationType::TYPE_STAFF_TASK,
+                    $lead->getEntity()->getId(),
+                    $item
+                );
+            }
+        }
+
+        // если лид создан по правилу, тогда пробуем перевести лид на этап выбранный пользователем
+        // изменение этапа происходит отдельным действием, чтобы в логе была отдельная запись
+        if ($creationRule->getCreateNew() && $creationRule->getNextStageId()) {
+            $lead->moveOnStage($this->stageFactory->fromId($creationRule->getNextStageId()));
+        }
+
+        // если лид создан по правилу, тогда пробуем передать лид выбранному пользователю
+        // изменение владельца и исполнителя происходит отдельным действием, чтобы в логе была отдельная запись
+        if ($creationRule->getCreateNew() && $creationRule->getNextOwnerId()) {
+            $lead->changeOwner($creationRule->getNextOwnerId());
+        }
+
+        if ($creationRule->getSurveyAnswer()) {
+            $surveyAnswerForm = new AnswerForm();
+            $surveyAnswer = ['leadId' => $lead->getEntity()->getId()] + $creationRule->getSurveyAnswer();
+            if (!$surveyAnswerForm->isValid($surveyAnswer)) {
+                throw new RuntimeException('Ошибка опроса: ' . json_encode($surveyAnswerForm->getMessages(), JSON_UNESCAPED_UNICODE));
+            }
+
+            $this->surveyAnswerHandler->passSurvey($surveyAnswerForm);
+        }
+
+        if ($creationRule->getCreateNew() && $creationRule->getProps()) {
+            $this->leadPropUpdater->updatePropValues($lead->getProps(), $creationRule->getProps());
+            $this->leadPropRepo->savePropValueStorage($lead->getProps());
+        }
+
+        $prevEventAuthor = $this->eventGenerator->getEventAuthor();
+        if ($creationRule->getCreatedBy()) {
+            $this->eventGenerator->setEventAuthor($creationRule->getCreatedBy());
+        }
+        $this->leadCrud->saveModel($lead);
+        $this->eventGenerator->setEventAuthor($prevEventAuthor);
+
+        return $lead;
+    }
 }
