5,0.04791861,-0.01888649,0.01363765,-0.02013903,-0.02117497,0.06598864,0.00968014,0.00817202,-0.04750109,0.0159857,0.04993769,-0.00039461,0.0270502,-0.02478035,-0.02524772,0.00509503,0.21945873,0.01020985,-0.04333948,0.0024582,-0.06403922,0.04831686,0.0061107,0.01398457,-0.03655056,-0.00854032,0.09610217,-0.00574185,-0.01636182,0.06098972,-0.04234766,0.03443035,-0.0160064,-0.01465786,-0.04752144,-0.00744628,-0.00905747,0.06175574,0.07702431,-0.02182686,-0.06820928,-0.02152339,0.01880796,0.01740393,-0.01288723,-0.02130022,-0.01191839,0.04113882,0.02359912,0.01459683,0.00871786,-0.03701676,0.01877696,-0.02636303,-0.02214371,0.03874311,0.01682232,0.04250837,0.00633191],"last_embed":{"tokens":396,"hash":"1h64ff8"}}},"last_read":{"hash":"1h64ff8","at":1778944038706},"class_name":"SmartSource","last_import":{"mtime":1767972869387,"size":293928,"at":1778943860072,"hash":"1h64ff8"},"blocks":{"#---frontmatter---":[1,9],"#":[11,36],"#Перехожу к самой сути":[37,66],"#Перехожу к самой сути#😎 Пикапер - конечно же никакая не жертва. Пикапер - это охотник.":[39,40],"#Перехожу к самой сути#🏹 Этот человек умеет добывать то, что ему нужно. Для результативной охоты необходимо знать: какова твоя цель, иметь план ее достижения и соответствующие орудия охоты.":[41,66],"#Перехожу к самой сути#🏹 Этот человек умеет добывать то, что ему нужно. Для результативной охоты необходимо знать: какова твоя цель, иметь план ее достижения и соответствующие орудия охоты.#{1}":[43,44],"#Перехожу к самой сути#🏹 Этот человек умеет добывать то, что ему нужно. Для результативной охоты необходимо знать: какова твоя цель, иметь план ее достижения и соответствующие орудия охоты.#{2}":[45,46],"#Перехожу к самой сути#🏹 Этот человек умеет добывать то, что ему нужно. Для результативной охоты необходимо знать: какова твоя цель, иметь план ее достижения и соответствующие орудия охоты.#{3}":[47,55],"#Перехожу к самой сути#🏹 Этот человек умеет добывать то, что ему нужно. Для результативной охоты необходимо знать: какова твоя цель, иметь план ее достижения и соответствующие орудия охоты.####📝Далее в ход идет программирование девушки на свой внешний образ + умение общаться + внутренний образ = общий успех в пикапе.":[56,66],"#Перехожу к самой сути#🏹 Этот человек умеет добывать то, что ему нужно. Для результативной охоты необходимо знать: какова твоя цель, иметь план ее достижения и соответствующие орудия охоты.####📝Далее в ход идет программирование девушки на свой внешний образ + умение общаться + внутренний образ = общий успех в пикапе.#{1}":[58,61],"#Перехожу к самой сути#🏹 Этот человек умеет добывать то, что ему нужно. Для результативной охоты необходимо знать: какова твоя цель, иметь план ее достижения и соответствующие орудия охоты.####📝Далее в ход идет программирование девушки на свой внешний образ + умение общаться + внутренний образ = общий успех в пикапе.#{2}":[62,62],"#Перехожу к самой сути#🏹 Этот человек умеет добывать то, что ему нужно. Для результативной охоты необходимо знать: какова твоя цель, иметь план ее достижения и соответствующие орудия охоты.####📝Далее в ход идет программирование девушки на свой внешний образ + умение общаться + внутренний образ = общий успех в пикапе.#{3}":[63,63],"#Перехожу к самой сути#🏹 Этот человек умеет добывать то, что ему нужно. Для результативной охоты необходимо знать: какова твоя цель, иметь план ее достижения и соответствующие орудия охоты.####📝Далее в ход идет программирование девушки на свой внешний образ + умение общаться + внутренний образ = общий успех в пикапе.#{4}":[64,66],"#🕸️ МАТРИЦА ОБРАЗОВ":[67,79],"#🕸️ МАТРИЦА ОБРАЗОВ#{1}":[69,79],"#Далее приведу список сексуальных образов, чей стиль в одежде, манеры, повадки, мимику, взгляды, жесты, поведение и даже фразы я регулярно копирую и применяю в своих пикапах:":[80,258],"#Далее приведу список сексуальных образов, чей стиль в одежде, манеры, повадки, мимику, взгляды, жесты, поведение и даже фразы я регулярно копирую и применяю в своих пикапах:#{1}":[83,83],"#Далее приведу списо