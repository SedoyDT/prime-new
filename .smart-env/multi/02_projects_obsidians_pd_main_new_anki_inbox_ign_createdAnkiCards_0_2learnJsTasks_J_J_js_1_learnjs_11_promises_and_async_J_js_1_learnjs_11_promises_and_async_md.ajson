 Promise.any?":[146,184],"#Что делает Promise.any?#{1}":[147,184],"#Что делает Promise.all?":[185,210],"#Что делает Promise.all?#{1}":[186,210],"#Что делает Promise.Allsteled?":[211,229],"#Что делает Promise.Allsteled?#{1}":[212,229],"#Что будет c Promise.All если любой из промисов завершится ошибкой?":[230,245],"#Что будет c Promise.All если любой из промисов завершится ошибкой?#{1}":[231,245],"#Что можно сделать для отлова необработынных ошибок?":[246,271],"#Что можно сделать для отлова необработынных ошибок?#{1}":[247,271],"#Что Являются ли фрагменты кода ниже эквивалентными? Другими словами, ведут ли они себя одинаково во всех обстоятельствах, для всех переданных им обработчиков? promise.then(f1).catch(f2); promise.then(f1, f2);":[272,302],"#Что Являются ли фрагменты кода ниже эквивалентными? Другими словами, ведут ли они себя одинаково во всех обстоятельствах, для всех переданных им обработчиков? promise.then(f1).catch(f2); promise.then(f1, f2);#{1}":[273,302],"#Что в обзем по мелочи можно сказать про promise?":[303,325],"#Что в обзем по мелочи можно сказать про promise?#{1}":[304,325],"#Что в обзем по мелочи можно сказать про promise?[2]":[326,340],"#Что в обзем по мелочи можно сказать про promise?[2]#{1}":[327,340],"#Существует три уровня кросс-доменного доступа:":[341,359],"#Существует три уровня кросс-доменного доступа:#{1}":[342,359],"#Что можно сказать про onload/onerror?":[360,377],"#Что можно сказать про onload/onerror?#{1}":[361,377],"#Что аля итогово можно сказать про finally ?":[378,413],"#Что аля итогово можно сказать про finally ?#{1}":[379,413],"#Как выглядит примеры promise для различных ситуаций?":[414,478],"#Как выглядит примеры promise для различных ситуаций?#{1}":[415,478],"#Вызов .catch(f) – это сокращённый, «укороченный» вариант":[479,494],"#Вызов .catch(f) – это сокращённый, «укороченный» вариант#{1}":[480,494],"#Что можно сказать про catch?":[495,519],"#Что можно сказать про catch?#{1}":[496,519],"#Какие внутренние свойства есть у объекта Promise?":[520,535],"#Какие внутренние свойства есть у объекта Promise?#{1}":[521,535],"#Как называется функция, которую передают в new Promise();?":[536,552],"#Как называется функция, которую передают в new Promise();?#{1}":[537,552],"#Например, рассмотрим функцию loadScript(src):":[553,577],"#Например, рассмотрим функцию loadScript(src):#{1}":[554,577]},"outlinks":[],"metadata":{"tags":["#J_js_1_learnjs_11_promises_and_async","#js_1_learnjs_11_promises_and_async","#telegram"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[155,157],[165,174],[194,200],[251,261],[398,403],[419,468],[502,509],[557,563],[567,570]],"key":"02_projects/obsidians/pd_main_new/anki_inbox/ign/createdAnkiCards/0.2learnJsTasks/J/J_js_1_learnjs_11_promises_and_async/J_js_1_learnjs_11_promises_and_async.md"},
