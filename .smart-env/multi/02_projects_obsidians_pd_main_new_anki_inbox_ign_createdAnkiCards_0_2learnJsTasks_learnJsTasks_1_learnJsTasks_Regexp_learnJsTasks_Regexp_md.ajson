.03328463,0.1250075,0.03845084,-0.30701828,0.00926033,0.02127465,-0.00461804,0.03019174,0.00335893,0.05815555,-0.0300131,-0.03671564,-0.03921308,-0.03331861,0.03594802,0.0111394,0.00848415,-0.0065081,-0.00924095,0.05023843,0.01315336,0.08196696,-0.05401361,-0.0491391,0.05867155,0.21910989,-0.0468964,-0.03683482,-0.02373346,-0.02606861,0.01482125,0.0512743,0.04130989,-0.03279591,0.04777152,0.09977017,-0.00035821,-0.0269696,0.04575861,-0.03799639,0.04560263,-0.02234213,-0.0656581,-0.00045255,-0.00841329,-0.0156789,0.02681464,0.02575435,-0.0392932,-0.03982139,-0.05257884,-0.04078317,-0.00302103,-0.04658933,0.03272851,0.013838,0.02057218,0.02595887,0.05483374,-0.02880533,-0.05305274,-0.01844282,-0.06809641,-0.00858893,0.02673829,0.07426947,0.10661783,-0.02416667],"last_embed":{"tokens":403,"hash":"gn9fs3"}}},"last_read":{"hash":"gn9fs3","at":1778944010305},"class_name":"SmartSource","last_import":{"mtime":1767972869113,"size":13108,"at":1778943859813,"hash":"gn9fs3"},"blocks":{"#":[2,6],"#Например, у вас есть список имен файлов и вы хотите найти только файлы с расширением pdf. После ввода выражения ^\\w+\\.pdf$ это будет работать. Значение определений в этом выражении станет яснее по мере выполнения шагов.":[7,22],"#Например, у вас есть список имен файлов и вы хотите найти только файлы с расширением pdf. После ввода выражения ^\\w+\\.pdf$ это будет работать. Значение определений в этом выражении станет яснее по мере выполнения шагов.#{1}":[8,22],"#Жадные квантификаторы":[23,59],"#Жадные квантификаторы#{1}":[24,59],"#Что такое квантификаторы regexp":[60,103],"#Что такое квантификаторы regexp#{1}":[61,103],"#Запишите выражение, которое будет соответствовать чему-либо, кроме слов beor и beur в тексте. Сделайте это, используя отрицательный набор символов.":[104,119],"#Запишите выражение, которое будет соответствовать чему-либо, кроме слов beor и beur в тексте. Сделайте это, используя отрицательный набор символов.#{1}":[105,119],"#Напишите фразу, которая соответствует каждому слову в тексте. Единственные символы, которые меняются - это инициалы слов.":[120,136],"#Напишите фразу, которая соответствует каждому слову в тексте. Единственные символы, которые меняются - это инициалы слов.#{1}":[121,136],"#Введите выражение для выбора отдельных букв, цифр, пробелов и специальных символов в тексте. Вводимое выражение должно соответствовать любому символу":[137,152],"#Введите выражение для выбора отдельных букв, цифр, пробелов и специальных символов в тексте. Вводимое выражение должно соответствовать любому символу#{1}":[138,152],"#Чтобы найти числа в указанном диапазоне, начальный номер и конечный номер записываются в квадратных скобках [] с тире - между ними. Напишите выражение, которое выберет все числа от 3 до 6, включая самих себя.":[153,168],"#Чтобы найти числа в указанном диапазоне, начальный номер и конечный номер записываются в квадратных скобках [] с тире - между ними. Напишите выражение, которое выберет все числа от 3 до 6, включая самих себя.#{1}":[154,168],"#**Буквенный диапазон**":[169,187],"#**Буквенный диапазон**#{1}":[170,187],"#**Наборы негативных символов":[188,207],"#**Наборы негативных символов#{1}":[189,207],"#**Наборы негативных символов[2]":[208,227],"#**Наборы негативных символов[2]#{1}":[209,227],"#Если одним из символов в слове могут быть разные символы, мы записываем его в":[228,247],"#Если одним из символов в слове могут быть разные символы, мы записываем его в#{1}":[229,247],"#Если одним из символов в слове могут быть разные символы, мы записываем его в[2]":[248,258],"#Если одним из символов в слове могут быть разные символы, мы записываем его в[2]#{1}":[249,258]},"outlinks":[],"metadata":{"tags":["#learnJsTasks_Regexp","#Regexp","#telegram"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"02_projects/obsidians/pd_main_new/anki_inbox/ign/createdAnkiCards/0.2learnJsTasks/learnJsTasks 1/learnJsTasks_Regexp/learnJsTasks_Regexp.md"},
