],"#Как выглядит объект литеральной нотации с применением стрелочной функции и демонстрацией отсутсвия this у стрелочной функции?#{1}":[173,196],"#Как работает Property accessors( доступ к свойствам) в объектах в js?":[197,227],"#Как работает Property accessors( доступ к свойствам) в объектах в js?#{1}":[198,227],"#В чем разница между литеральной нотацией и json?":[228,248],"#В чем разница между литеральной нотацией и json?#{1}":[229,248],"#Как выглядит пример передачи функции в объект и последующий вызов этой функции?":[249,275],"#Как выглядит пример передачи функции в объект и последующий вызов этой функции?#{1}":[250,275],"#Как работает ключевое слово this в методах?":[276,300],"#Как работает ключевое слово this в методах?#{1}":[277,300],"#Как можно добавить метод в литерале объекта?":[301,341],"#Как можно добавить метод в литерале объекта?#{1}":[302,341],"#Что самое главное о сборке мусора нужно знать?":[342,371],"#Что самое главное о сборке мусора нужно знать?#{1}":[343,371],"#Напишите код, выполнив задание из каждого пункта отдельной строкой:    Создайте пустой объект user. Добавьте свойство name со значением John.    Добавьте свойство surname со значением Smith.    Измените значение свойства name на Pete.    Удалите свойство name из объекта.":[372,394],"#Напишите код, выполнив задание из каждого пункта отдельной строкой:    Создайте пустой объект user. Добавьте свойство name со значением John.    Добавьте свойство surname со значением Smith.    Измените значение свойства name на Pete.    Удалите свойство name из объекта.#{1}":[373,394],"#Что в общем и кратце можно сказать про объекты в js?":[395,439],"#Что в общем и кратце можно сказать про объекты в js?#{1}":[396,439],"#Что такое целочисленное свойство?":[440,499],"#Что такое целочисленное свойство?#{1}":[441,499],"#Как работает упорядочение свойств объекта?":[500,543],"#Как работает упорядочение свойств объекта?#{1}":[501,543],"#Какой цикл можно использовать для перебора свойств объекта?":[544,589],"#Какой цикл можно использовать для перебора свойств объекта?#{1}":[545,589],"#Что делает оператор in?":[590,641],"#Что делает оператор in?#{1}":[591,641],"#Что можно сказать про проверку существования свойства":[642,671],"#Что можно сказать про проверку существования свойства#{1}":[643,671],"#Что можно сказать про ограничения на имена свойств в объекте?":[672,729],"#Что можно сказать про ограничения на имена свойств в объекте?#{1}":[673,729],"#Как может выглядеть функция для создания пользователя и что про нее можно скзать?":[730,782],"#Как может выглядеть функция для создания пользователя и что про нее можно скзать?#{1}":[731,782],"#Что можно сказать про вычисляемые свойства объекта js?":[783,836],"#Что можно сказать про вычисляемые свойства объекта js?#{1}":[784,836],"#Для свойств, имена которых состоят из нескольких слов, доступ к значению «через точку»":[837,920],"#Для свойств, имена которых состоят из нескольких слов, доступ к значению «через точку»#{1}":[838,920],"#Объект объявленный как константа ...":[921,954],"#Объект объявленный как константа ...#{1}":[922,954],"#Имя свойства может состоять из ...":[955,982],"#Имя свойства может состоять из ...#{1}":[956,982],"#Что можно использовать для удаления свойства в объекте?":[983,1001],"#Что можно использовать для удаления свойства в объекте?#{1}":[984,1001],"#Что можно при использовании литерального синтаксиса?":[1002,1050],"#Что можно при использовании литерального синтаксиса?#{1}":[1003,1050],"#Что такое литеральная нотация?":[1051,1067],"#Что такое литеральная нотация?#{1}":[1052,1067],"#Что такое объекты и как можно создать пустой объект?":[1068,1090],"#Что такое объекты и как можно создать пустой объект?#{1}":[1069,1090]},"outlinks":[],"metadata":{"tags":["#learnJsTasks_part_1_4_Objects_basics","#part_1_4_Objects_basics","#telegram"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[12,23],[40,61],[82,89],[124,135],[157,161],[177,186],[202,217],[254,265],[281,290],[306,331],[377,384],[449,455],[458,470],[476,489],[5