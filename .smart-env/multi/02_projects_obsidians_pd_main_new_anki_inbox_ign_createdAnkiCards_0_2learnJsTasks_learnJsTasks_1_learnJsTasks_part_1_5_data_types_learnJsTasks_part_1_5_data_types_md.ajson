», «ВС».":[99,121],"#Напишите функцию getWeekDay(date), показывающую день недели в коротком формате: «ПН», «ВТ», «СР», «ЧТ», «ПТ», «СБ», «ВС».#{1}":[100,121],"#Создайте объект Date для даты: 20 февраля 2012 года, 3 часа 12 минут. Временная зона – местная.":[122,138],"#Создайте объект Date для даты: 20 февраля 2012 года, 3 часа 12 минут. Временная зона – местная.#{1}":[123,138],"#Что в общем можно сказать про Date в js?":[139,174],"#Что в общем можно сказать про Date в js?#{1}":[140,174],"#Что делает метод Date.parse(str)?":[175,198],"#Что делает метод Date.parse(str)?#{1}":[176,198],"#У нас есть объект salaries с зарплатами:":[199,244],"#У нас есть объект salaries с зарплатами:#{1}":[200,210],"#У нас есть объект salaries с зарплатами:#{2}":[211,211],"#У нас есть объект salaries с зарплатами:#{3}":[212,213],"#У нас есть объект salaries с зарплатами:#{4}":[214,244],"#У нас есть объект:":[245,2697],"#У нас есть объект:#{1}":[246,257],"#У нас есть объект:#{2}":[258,258],"#У нас есть объект:#{3}":[259,259],"#У нас есть объект:#{4}":[260,261],"#У нас есть объект:#{5}":[262,2697]},"outlinks":[],"metadata":{"tags":["#learnJsTasks_part_1_5_data_types","#part_1_5_data_types","#telegram"]},"task_lines":[],"tasks":{},"codeblock_ranges":[[76,88],[144,164],[182,188],[202,208],[218,233],[249,254],[264,273],[274,278],[286,306],[309,318],[321,344],[350,356],[361,368],[386,390],[410,414],[421,427],[433,437],[445,462],[488,505],[515,533],[546,551],[554,561],[579,595],[606,611],[621,641],[653,656],[661,670],[675,682],[688,693],[698,705],[713,808],[818,825],[831,836],[839,846],[854,859],[869,886],[905,936],[947,965],[980,1004],[1014,1024],[1058,1071],[1096,1138],[1161,1177],[1187,1238],[1253,1257],[1287,1306],[1318,1418],[1426,1432],[1456,1509],[1514,1535],[1540,1562],[1571,1575],[1579,1586],[1590,1596],[1601,1619],[1626,1650],[1659,1673],[1681,1685],[1696,1730],[1735,1740],[1744,1765],[1771,1773],[1785,1806],[1812,1825],[1836,1847],[1861,1881],[1887,1906],[1911,1915],[1924,1943],[1948,