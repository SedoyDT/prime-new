.00029813,0.06544643,0.07415947,0.01492428,-0.00503511,-0.02220965,0.07725173,0.01518379,0.05587749,-0.03597882,-0.01550454,0.03226123,0.19584951,-0.01778102,-0.0071129,-0.01487236,-0.05717492,0.01163322,0.03209494,0.0904441,-0.02028604,0.04340337,0.07321805,-0.04042675,-0.00234927,0.06266177,-0.03538514,0.01211406,-0.02298305,-0.03161541,-0.08209313,0.04367666,-0.01413762,0.03329033,0.04905245,-0.0493978,-0.06528475,-0.03407361,-0.01512808,-0.00573152,-0.05964363,0.04901764,0.01204941,0.02488406,0.01964898,0.0687445,-0.05134923,-0.05747193,-0.02445839,-0.00746056,-0.0010705,0.00829616,0.05173983,0.05421269,0.02666985],"last_embed":{"tokens":401,"hash":"cjjpu1"}}},"last_read":{"hash":"cjjpu1","at":1778943975943},"class_name":"SmartSource","last_import":{"mtime":1776102951669,"size":12619,"at":1778943859549,"hash":"cjjpu1"},"blocks":{"#":[2,36],"#Отлично! Тогда делаем **мини-гайд по правильному нанесению гелей для CLEAN**, чтобы не переборщить и всё работало максимально эффективно.":[37,109],"#Отлично! Тогда делаем **мини-гайд по правильному нанесению гелей для CLEAN**, чтобы не переборщить и всё работало максимально эффективно.#{1}":[38,109],"#Принял. Работаем **строго в режиме “допустимый максимум”**, без откатов и «а давай помягче». Ниже — **РАСШИРЕННЫЙ, ОКОНЧАТЕЛЬНЫЙ график на каждый день**, куда я аккуратно **встроил перкуссию и вакуумный очиститель**, не выходя за физиологические пределы кожи и нервной системы.":[110,278],"#Принял. Работаем **строго в режиме “допустимый максимум”**, без откатов и «а давай помягче». Ниже — **РАСШИРЕННЫЙ, ОКОНЧАТЕЛЬНЫЙ график на каждый день**, куда я аккуратно **встроил перкуссию и вакуумный очиститель**, не выходя за физиологические пределы кожи и нервной системы.#{1}":[111,278],"#Да, ты прав — **мы договаривались про допустимый максимум**.":[279,369],"#Да, ты прав — **мы договаривались про допустимый максимум**.#{1}":[280,369],"#Rf":[370,379],"#Rf#{1}":[371,379]},"outlinks":[],"metadata":{"tags":["#М_Массаж","#Массаж","#telegram"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"02_projects/obsidians/pd_main_new/anki_inbox/М/М_Массаж/М_Массаж.md"},
