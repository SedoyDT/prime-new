xt[data-tooltip-id=' +tooltipTextInContainer.data('tooltip-id')+ ']',##Почему это важно?":[165,170],"#Что делает этот код             $('body').on('click', 'div#depotTooltipContainer div#tooltipText[data-tooltip-id=' +tooltipTextInContainer.data('tooltip-id')+ ']',##Почему это важно?#{1}":[167,168],"#Что делает этот код             $('body').on('click', 'div#depotTooltipContainer div#tooltipText[data-tooltip-id=' +tooltipTextInContainer.data('tooltip-id')+ ']',##Почему это важно?#{2}":[169,170],"#Что делает этот код             $('body').on('click', 'div#depotTooltipContainer div#tooltipText[data-tooltip-id=' +tooltipTextInContainer.data('tooltip-id')+ ']',##Итог":[171,183],"#Что делает этот код             $('body').on('click', 'div#depotTooltipContainer div#tooltipText[data-tooltip-id=' +tooltipTextInContainer.data('tooltip-id')+ ']',##Итог#{1}":[173,183],"#Что делает этот код         $('body').on('click', '.depotTooltipWrapper', function(event){?":[184,238],"#Что делает этот код         $('body').on('click', '.depotTooltipWrapper', function(event){?#{1}":[185,190],"#Что делает этот код         $('body').on('click', '.depotTooltipWrapper', function(event){?##Расшифровка кода":[191,206],"#Что делает этот код         $('body').on('click', '.depotTooltipWrapper', function(event){?##Расшифровка кода#{1}":[193,198],"#Что делает этот код         $('body').on('click', '.depotTooltipWrapper', function(event){?##Расшифровка кода#{2}":[199,200],"#Что делает этот код         $('body').on('click', '.depotTooltipWrapper', function(event){?##Расшифровка кода#{3}":[201,202],"#Что делает этот код         $('body').on('click', '.depotTooltipWrapper', function(event){?##Расшифровка кода#{4}":[203,204],"#Что делает этот код         $('body').on('click', '.depotTooltipWrapper', function(event){?##Расшифровка кода#{5}":[205,206],"#Что делает этот код         $('body').on('click', '.depotTooltipWrapper', function(event){?##Зачем это нужно?":[207,214],"#Что делает этот код         $('bo