6,-0.07199771,0.02144658,0.0328798,0.04960715,0.00256926,-0.00905795,-0.05274688,-0.00984848,0.05907118,0.04057474,-0.00054973,-0.02320817,-0.02123031,0.07326635,0.02340274,0.07962252,-0.03374469,-0.0146489,0.06727887,0.21167767,-0.03439689,0.0054296,-0.03295554,-0.02716375,0.03860524,0.02481246,0.07284209,-0.03307502,0.05212254,0.09118381,-0.05198402,-0.01225349,0.07149155,-0.0254162,0.02656174,-0.03294548,-0.02275747,-0.05562269,0.03621037,-0.02858645,0.0373676,0.04953659,-0.03156338,-0.04802911,-0.06617763,0.0001406,-0.0230216,-0.06537329,0.02057754,0.03432539,0.03563036,0.02175291,0.07305202,-0.03326679,-0.04710101,-0.04577085,-0.04441205,0.00937059,0.00719389,0.0291647,0.05240465,0.01232095],"last_embed":{"tokens":443,"hash":"1ih8m8s"}}},"last_read":{"hash":"1ih8m8s","at":1778943971405},"class_name":"SmartSource","last_import":{"mtime":1767972869165,"size":95735,"at":1778943859541,"hash":"1ih8m8s"},"blocks":{"#":[2,6],"#ВДХ | 1278":[7,55],"#ВДХ | 1278#{1}":[8,55],"#1.2. Про игру и игроков":[56,85],"#1.2. Про игру и игроков#{1}":[57,85],"#Что тебе люди? Ты ведь и сам человек. Возможно.":[86,102],"#Что тебе люди? Ты ведь и сам человек. Возможно.#{1}":[87,102],"#Созвучие голосов в песне радует так же, как и совпадение случайных движений мира в сознании воспринимающего.":[103,143],"#Созвучие голосов в песне радует так же, как и совпадение случайных движений мира в сознании воспринимающего.#{1}":[104,143],"#1.1.3":[144,191],"#1.1.3#{1}":[145,191],"#ВДХ | 1153":[192,223],"#ВДХ | 1153#{1}":[193,223],"#ВДХ | 1153[2]":[224,255],"#ВДХ | 1153[2]#{1}":[225,255],"#3.6":[256,289],"#3.6#{1}":[257,289],"#В состояниях нужно всегда уметь вычленять отдельные составляющие, то есть состояние тела, состояние чувств, состояние образов, состояние ума, состояние духа и состояние обстоятельств.":[290,324],"#В состояниях нужно всегда уметь вычленять отдельные составляющие, то есть состояние тела, состояние чувств, состояние образов, состояние ума, состояние духа и состояние обстоятельств.#{1}":[291,324],"#3.2":[325,362],"#3.2#{1}":[326,362],"#3.1":[363,387],"#3.1#{1}":[364,387],"#Если ты тратишь слишком много силы на какую-то позицию в ущерб другим, забывая о других, тогда твоя система разлаживается и теряет равновесие. Потому, когда тебя вдруг вовлекает в какой-то поток, помни обо всех остальных.":[388,411],"#Если ты тратишь слишком много силы на какую-то позицию в ущерб другим, забывая о других, тогда твоя система разлаживается и теряет равновесие. Потому, когда тебя вдруг вовлекает в какой-то поток, помни обо всех остальных.#{1}":[389,411],"#Четвертая питает пятую, которая питает первую, будучи сдерживаемой четвертой.":[412,451],"#Четвертая питает пятую, которая питает первую, будучи сдерживаемой четвертой.#{1}":[413,451],"#Все надеешься поймать свой случай? Поздно уже. Остались только воздаяния.":[452,498],"#Все надеешься поймать свой случай? Поздно уже. Остались только воздаяния.#{1}":[453,498],"#2.4":[499,528],"#2.4#{1}":[500,528],"#2.2":[529,566],"#2.2#{1}":[530,566],"#2.1":[567,592],"#2.1#{1}":[568,592],"#Отсутствия осмысленных действий никогда не бывает в пространстве творческих состояний, в пространстве игры.":[593,628],"#Отсутствия осмысленных действий никогда не бывает в пространстве творческих состояний, в пространстве игры.#{1}":[594,628],"#1.5.5":[629,654],"#1.5.5#{1}":[630,654],"#Чего только нет в человеческом сердце.":[655,695],"#Чего только нет в человеческом сердце.#{1}":[656,695],"#1.4.9":[696,744],"#1.4.9#{1}":[697,744],"#бережлив в проявлении вовне своих переживаний. Тогда все будет хорошо.":[745,773],"#бережлив в проявлении вовне своих переживаний. Тогда все будет хорошо.#{1}":[746,773],"#Пока собираешься, время уходит.":[774,814],"#Пока собираешься, время уходит.#{1}":[775,814],"#Все пять движений игры – это пять видов движения духа. Нужно учиться делать играючи движение духа, то есть чувствовать качество исследования, обучения, общения, творчества и управления в каждом из движений.":[815,857],"#Все пять движений игры – это пять видов движения духа. Нужно учиться делать играючи движение духа, то есть чувствовать качество исследования, обучения, общения, творчества и управления в каждом из движений.#{1}":[816,857],"#1.4. Применение исследовательского движения духа":[858,899],"#1.4. Применение исследовательского движения духа#{1}":[859,899],"#ВДХ | 1719":[900,936],"#ВДХ | 1719#{1}":[901,936],"#1.3.7":[937,963],"#1.3.7#{1}":[938,963],"#Исследуя, обучайся. Обучая, исследуй. И обязательно играй, превращая одно в другое, стирая грань, подменяя суть. Только так.":[964,999],"#Исследуя, обучайся. Обучая, исследуй. И обязательно играй, превращая одно в другое, стирая грань, подменяя суть. Только так.#{1}":[965,999],"#это состояние свободы, переживание свободы вне зависимости от того, какие обстоятельства пытаются окружить и сковать твою свободу.":[1000,1051],"#это состояние свободы, переживание свободы вне зависимости от того, какие обстоятельства пытаются окружить и сковать твою свободу.#{1}":[1001,1051],"#Тело-душа-дух, то есть тело-чувство-сознание, представлены лестницей ощущений-чувств-образов-понятий-смыслов-действий.":[1052,1095],"#Тело-душа-дух, то есть тело-чувство-сознание, представлены лестницей ощущений-чувств-образов-понятий-смыслов-действий.#{1}":[1053,1095],"#видеть закономерности изменений в ощущениях, ибо в этом случае они перестают волноваться переживаемыми чувствами, и ты видишь лишь движущиеся потоки, которые переходят в теле изнутри вовне и извне вовнутрь, создавая сообщение между поверхностными и глубинными отделами пространства ощущений.":[1096,1118],"#видеть закономерности изменений в ощущениях, ибо в этом случае они перестают волноваться переживаемыми чувствами, и ты видишь лишь движущиеся потоки, которые переходят в теле изнутри вовне и извне вовнутрь, создавая сообщение между поверхностными и глубинными отделами пространства ощущений.#{1}":[1097,1118],"#Дух – это пространство дум, которое требует подключения воли, потому что иначе поток все время уносит тебя в переживаемые ощущения, а каждое переживаемое ощущение создает чувственные образы, с помощью которых дух создает описание происходящего.":[1119,1145],"#Дух – это пространство дум, которое требует подключения воли, потому что иначе поток все время уносит тебя в переживаемые ощущения, а каждое переживаемое ощущение создает чувственные образы, с помощью которых дух создает описание происходящего.#{1}":[1120,1145],"#1.1.2":[1146,1251],"#1.1.2#{1}":[1147,1251],"#1.1. Как нужно рассматривать игру":[1252,1281],"#1.1. Как нужно рассматривать игру#{1}":[1253,1281],"#1.1. Как нужно рассматривать игру[2]":[1282,1311],"#1.1. Как нужно рассматривать игру[2]#{1}":[1283,1311],"#Чтобы тронуть сердце собеседника нужно от сердца и обращаться":[1312,1326],"#Чтобы тронуть сердце собеседника нужно от сердца и обращаться#{1}":[1313,1326],"#Если ты точно знаешь, что узор обстоятельств действительно  поменялся. То есть, произошло событие, вглядись внимательно в его особенности, отдели, определи и назови":[1327,1341],"#Если ты точно знаешь, что узор обстоятельств действительно  поменялся. То есть, произошло событие, вглядись внимательно в его особенности, отдели, определи и назови#{1}":[1328,1341],"#Если ты точно знаешь, что узор обстоятельств действительно  поменялся. То есть, произошло событие, вглядись внимательно в его особенности, отдели, определи и назови. Название дать обязательно . Это определит правила игры в узоре обстоятельств.":[1342,1356],"#Если ты точно знаешь, что узор обстоятельств действительно  поменялся. То есть, произошло событие, вглядись внимательно в его особенности, отдели, определи и назови. Название дать обязательно . Это определит правила игры в узоре обстоятельств.#{1}":[1343,1356],"#Святость это прежде всего правильные поступки":[1357,1371],"#Святость это прежде всего правильные поступки#{1}":[1358,1371],"#У настоящего игрока не бывает удачи или неудачи. Его судьбу нельзя назвать хорошей или плохой. Он всегда действует и ходит лишь в ответ на движение внешних сил. Если что-то выпадает ему , то он просто его испытывает":[1372,1386],"#У настоящего игрока не бывает удачи или неудачи. Его судьбу нельзя назвать хорошей или плохой. Он всегда действует и ходит лишь в ответ на движение внешних сил. Если что-то выпадает ему , то он просто его испытывает#{1}":[1373,1386],"#Творчество - это всегда сотворение нового смысла":[1387,1401],"#Творчество - это всегда сотворение нового смысла#{1}":[1388,1401],"#Значения и знаки только в смыслах":[1402,1416],"#Значения и знаки только в смыслах#{1}":[1403,1416],"#Куда бы ты не бегал - дорога одна к себе":[1417,1431],"#Куда бы ты не бегал - дорога одна к себе#{1}":[1418,1431],"#Любое время - для тебя":[1432,1446],"#Любое время - для тебя#{1}":[1433,1446],"#Если ты точно знаешь, что узор обстоятельств действительно  поменялся. То есть, произошло событие, вглядись внимательно в его особенности, отдели, определи и назови. Название дать обязательно . Это определит правила игры в узоре обстоятельств.[2]":[1447,1461],"#Если ты точно знаешь, что узор обстоятельств действительно  поменялся. То есть, произошло событие, вглядись внимательно в его особенности, отдели, определи и назови. Название дать обязательно . Это определит правила игры в узоре обстоятельств.[2]#{1}":[1448,1461],"#Святость это прежде всего правильные поступки[2]":[1462,1476],"#Святость это прежде всего правильные поступки[2]#{1}":[1463,1476],"#У настоящего игрока не бывает удачи или неудачи. Его судьбу нельзя назвать хорошей или плохой. Он всегда действует и ходит лишь в ответ на движение внешних сил. Если что-то выпадает ему , то он просто его испытывает[2]":[1477,1491],"#У настоящего игрока не бывает удачи или неудачи. Его судьбу нельзя назвать хорошей или плохой. Он всегда действует и ходит лишь в ответ на движение внешних сил. Если что-то выпадает ему , то он просто его испытывает[2]#{1}":[1478,1491],"#Может и потерял, а может и приобрел со своей потерей. Не торопись с выводами":[1492,1506],"#Может и потерял, а может и приобрел со своей потерей. Не торопись с выводами#{1}":[1493,1506],"#Только покой управляет обстоятельствами":[1507,1521],"#Только покой управляет обстоятельствами#{1}":[1508,1521],"#Быть увлеченным игрой???? Ааааа":[1522,1536],"#Быть увлеченным игрой???? Ааааа#{1}":[1523,1536],"#Не будь увлеченным игрой???? Разве так может быть":[1537,1551],"#Не будь увлеченным игрой???? Разве так может быть#{1}":[1538,1551],"#Чем более плавное, медленное и тонко усилие ты способен совершать, тем лучшие плоды оно понисет на поле будущих обстоятельств":[1552,1566],"#Чем более плавное, медленное и тонко усилие ты способен совершать, тем лучшие плоды оно понисет на поле будущих обстоятельств#{1}":[1553,1566],"#Тишина всегда сильнее, чем шум":[1567,1581],"#Тишина всегда сильнее, чем шум#{1}":[1568,1581],"#Быть увлеченным игрой???? Ааааа[2]":[1582,1596],"#Быть увлеченным игрой???? Ааааа[2]#{1}":[1583,1596],"#Не будь увлеченным игрой???? Разве так может быть[2]":[1597,1611],"#Не будь увлеченным игрой???? Разве так может быть[2]#{1}":[1598,1611],"#Чем более плавное, медленное и тонко усилие ты способен совершать, тем лучшие плоды оно понисет на поле будущих обстоятельств[2]":[1612,1626],"#Чем более плавное, медленное и тонко усилие ты способен совершать, тем лучшие плоды оно понисет на поле будущих обстоятельств[2]#{1}":[1613,1626],"#Тишина всегда сильнее, чем шум[2]":[1627,1641],"#Тишина всегда сильнее, чем шум[2]#{1}":[1628,1641],"#Выигрыш и проигрыш это очень обычные для игры движения мира. Не испытывай ничего особенного по их поводу. Постарайся не забыть в миг их появления в поле твоего восприятия.":[1642,1656],"#Выигрыш и проигрыш это очень обычные для игры движения мира. Не испытывай ничего особенного по их поводу. Постарайся не забыть в миг их появления в поле твоего восприятия.#{1}":[1643,1656],"#В игре ценности все время перераспределяются":[1657,1671],"#В игре ценности все время перераспределяются#{1}":[1658,1671],"#В игре не думают, а осмысленно действуют":[1672,1686],"#В игре не думают, а осмысленно действуют#{1}":[1673,1686],"#Верность и вера в голове глупца превращаются в упрямство и тупость":[1687,1701],"#Верность и вера в голове глупца превращаются в упрямство и тупость#{1}":[1688,1701],"#Играй только на противоречиях":[1702,1716],"#Играй только на противоречиях#{1}":[1703,1716],"#Случится лишь то, что может случиться, но ждать нужно сверхъестветственного":[1717,1731],"#Случится лишь то, что может случиться, но ждать нужно сверхъестветственного#{1}":[1718,1731],"#Не бойся - страх тебя сам найдет":[1732,1746],"#Не бойся - страх тебя сам найдет#{1}":[1733,1746],"#Не играл - проиграл":[1747,1761],"#Не играл - проиграл#{1}":[1748,1761],"#Переоценил - проиграл игру":[1762,1776],"#Переоценил - проиграл игру#{1}":[1763,1776],"#Недооценил - проиграл игру":[1777,1791],"#Недооценил - проиграл игру#{1}":[1778,1791],"#Позавидовал - проиграл игру":[1792,1806],"#Позавидовал - проиграл игру#{1}":[1793,1806],"#Имею намерение - потому и зависим":[1807,1821],"#Имею намерение - потому и зависим#{1}":[1808,1821],"#Когда у власти память коротка, тогда эту власть долго будут помнить":[1822,1836],"#Когда у власти память коротка, тогда эту власть долго будут помнить#{1}":[1823,1836],"#Не жди награды за добро, дешевле обойдется":[1837,1851],"#Не жди награды за добро, дешевле обойдется#{1}":[1838,1851],"#Вопрос всегда должен быть в утвердительной интонации":[1852,1866],"#Вопрос всегда должен быть в утвердительной интонации#{1}":[1853,1866],"#Когда в наградах и наказаниях исходят из личного расположения или нелюбви, тогда никто не будет подчиняться":[1867,1881],"#Когда в наградах и наказаниях исходят из личного расположения или нелюбви, тогда никто не будет подчиняться#{1}":[1868,1881],"#Тот кто первым делает последний ход, тот и выиграл.":[1882,1896],"#Тот кто первым делает последний ход, тот и выиграл.#{1}":[1883,1896],"#То что ты скрываешь от другого, ты скрываешь и от себя":[1897,1911],"#То что ты скрываешь от другого, ты скрываешь и от себя#{1}":[1898,1911],"#Ешь побольше и пожаднее - быстрее умрешь":[1912,1921],"#Ешь побольше и пожаднее - быстрее умрешь#{1}":[1913,1921]},"outlinks":[],"metadata":{"tags":["#К_Книга_ИсскуствоИгрыСмиром","#Книга_ИсскуствоИгрыСмиром","#telegram"]},"task_lines":[],"tasks":{},"codeblock_ranges":[],"key":"02_projects/obsidians/pd_main_new/anki_inbox/К/К_Книга_ИсскуствоИгрыСмиром/К_Книга_ИсскуствоИгрыСмиром.md"},
