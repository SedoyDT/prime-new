16,153],"#а##1. **Некорректный вызов функции в `setTimeout`**":[154,163],"#а##1. **Некорректный вызов функции в `setTimeout`**#{1}":[156,163],"#а##2. **Неверное использование `setTimeout`**":[164,169],"#а##2. **Неверное использование `setTimeout`**#{1}":[166,166],"#а##2. **Неверное использование `setTimeout`**#{2}":[167,167],"#а##2. **Неверное использование `setTimeout`**#{3}":[168,169],"#а##Исправленный вариант:":[170,179],"#а##Исправленный вариант:#{1}":[172,179],"#а##Что происходит в исправленном коде:":[180,187],"#а##Что происходит в исправленном коде:#{1}":[182,184],"#а##Что происходит в исправленном коде:#{2}":[185,187],"#а##Пример:":[188,202],"#а##Пример:#{1}":[190,202],"#а##Заключение:":[203,217],"#а##Заключение:#{1}":[205,217],"#Что происходит в функции?":[218,322],"#Что происходит в функции?#{1}":[219,241],"#Что происходит в функции?##1. **Добавление метода `defer` в `Function.prototype`**":[242,251],"#Что происходит в функции?##1. **Добавление метода `defer` в `Function.prototype`**#{1}":[244,251],"#Что происходит в функции?##2. **Сохранение ссылки на исходную функцию**":[252,259],"#Что происходит в функции?##2. **Сохранение ссылки на исходную функцию**#{1}":[254,259],"#Что происходит в функции?##3. **Возвращение новой функции**":[260,272],"#Что происходит в функции?##3. **Возвращение новой функции**#{1}":[262,269],"#Что происходит в функции?##3. **Возвращение новой функции**#{2}":[270,270],"#Что происходит в функции?##3. **Возвращение новой функции**#{3}":[271,272],"#Что происходит в функции?##4. **Использование `setTimeout` для отложенного вызова**":[273,284],"#Что происходит в функции?##4. **Использование `setTimeout` для отложенного вызова**#{1}":[275,280],"#Что происходит в функции?##4. **Использование `setTimeout` для отложенного вызова**#{2}":[281,281],"#Что происходит в функции?##4. **Использование `setTimeout` для отложенного вызова**#{3}":[282,282],"#Что происходит в функции?##4. **Использование `setTimeout` для отложенного вызова**#{4}":[283,284],"#Что происходит в функции?##5. **Пример использования**":[285,306],"#Что происходит в функции?##5. **Пример использования**#{1}":[287,298],"#Что происходит в функции?##5. **Пример использования**#{2}":[299,300],"#Что происходит в функции?##5. **Пример использования**#{3}":[301,302],"#Что происходит в функции?##5. **Пример использования**#{4}":[303,304],"#Что происходит в функции?##5. **Пример использования**#{5}":[305,306],"#Что происходит в функции?##Итог":[307,322],"#Что происходит в функции?##Итог#{1}":[309,322],"#Добавьте всем функциям в прототип метод defer(ms), который возвращает обёртку, откладывающую вызов функции на ms миллисекунд.":[323,352],"#Добавьте всем функциям в прототип метод defer(ms), который возвращает обёртку, откладывающую вызов функции на ms миллисекунд.#{1}":[324,352],"#Что можно сказать про встроенные прототтипы?":[353,373],"#Что можно сказать про встроенные прототтипы?#{1}":[354,373],"#Свойство \"prototype\" широко используется внутри самого языка JavaScript.":[374,389],"#Свойство \"prototype\" широко используется внутри самого языка JavaScript.#{1}":[375,389],"#Что кратко можно сказать о F.prototype?":[390,422],"#Что кратко можно сказать о F.prototype?#{1}":[391,422],"#У нас есть два хомяка: шустрый (speedy) и ленивый (lazy); оба наследуют от общего объекта hamster. Когда мы кормим одного хомяка, второй тоже наедается. Почему? Как это исправить?":[423,816],"#У нас есть два хомяка: шустрый (speedy) и ленивый (lazy); оба наследуют от общего объекта hamster. Когда мы кормим одного хомяка, второй тоже наедается. Почему? Как это исправить?#{1}":[424,816]},"outlinks":[{"title":"Prototype","target":"Prototype","line":39},{"title":"Prototype","target":"Prototype","line":41},{"title":"Prototype","target":"Prototype","line":67},{"title":"Prototype","target":"Prototype","line":69},{"title":"Prototype","target":"Prototype","line":72},{"title":"Prototype","target":"Prototype","line":83},{"title":"Prototype","target":"Prototype","line":85},{"title":